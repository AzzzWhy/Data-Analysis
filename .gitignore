# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.web-deps/

# GPU/CPU comparison cache: machine-specific timings, useless in version control
.gpu_vs_cpu_cache.json
agent/.gpu_vs_cpu_cache.json

# Generated demo datasets (multi-GB CSV). Produce one with:
#   scripts/memory_ceiling_test.py --rows 20000000 --columns 8
benchmark/demo/

# Scratch / data downloads
.dl/
*.zip
benchmark_data/
attribution_data/
ceiling_data/

# Personal dev helper for reaching a private host; not part of the submission
.tools/

# Logs and temp output
*.log.tmp
nohup.out

# OS
Thumbs.db
.DS_Store

# Demo outputs and local state (regenerated by the scripts)
deliverables/
agent/deliverables/
.last_dataset_path
# Local API connection files must never be published (default lives outside the repo).
connection.json
.connection-*
.env
external_tools.json
.external-tools-*

# Private project summaries: risk assessment and self-critique aimed at the author only.
# Kept on the PC outside the repository, never published.
PROJECT_SUMMARY_*.md

# Agent working notes and scratch, not project deliverables.
#
# docs/superpowers/plans/ used to be listed here because the plans written there quoted the real
# jump-host address, node name and SSH port, and the organiser's rules say that information must
# not appear in a code repository. Those plans have since been sanitized and committed, so the
# path is deliberately NOT ignored: an ignore rule over a tracked file silently swallows every
# future edit to it. If real host or port values ever reappear in a plan, scrub them rather than
# re-adding this rule.
.superpowers/

# Local demo data generated while testing the workbench.
_gui_demo/
